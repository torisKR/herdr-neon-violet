{
  "global": {
    "ctrl-shift-h": "mod.open:nv-code",
    "ctrl-shift-k": "mod.open:nv-shortcuts",
    "ctrl-shift-a": "mod.open:nv-toggle-agents",
    "ctrl-shift-d": "mod.open:devices",
    "ctrl-shift-u": "mod.open:nv-browser",
    "ctrl-shift-g": "mod.open:nv-toggle-prs",
    "ctrl-shift-m": "mod.open:devices",
    "ctrl-shift-j": {
      "command": "tab.new",
      "args": {
        "name": "Today",
        "mod": "nv-today"
      }
    },
    "ctrl-shift-l": {
      "command": "tab.new",
      "args": {
        "name": "Play check",
        "mod": "nv-play"
      }
    },
    "ctrl-shift-y": {
      "command": "tab.new",
      "args": {
        "name": "App pipeline",
        "mod": "nv-pipeline"
      }
    }
  },
  "layout:all-agents": {
    "ctrl-a": "all-agents.all",
    "ctrl-d": "all-agents.done",
    "ctrl-w": "all-agents.working",
    "ctrl-i": "all-agents.idle",
    "ctrl-b": "all-agents.blocked"
  },
  "terminal": {
    "ctrl-v": "mod.open:nv-paste"
  },
  "mod:editor": {
    "ctrl-s": "editor.save",
    "ctrl-shift-v": "editor.preview"
  }
}
