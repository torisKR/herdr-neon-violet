{
  "global": {
    "ctrl-shift-a": "layout.switch:all-agents",
    "ctrl-shift-d": "mod.open:devices",
    "ctrl-shift-u": {
      "command": "pane.split",
      "args": {
        "direction": "right",
        "argv": [
          "{{NV}}",
          "browse"
        ]
      }
    },
    "ctrl-shift-g": {
      "command": "pane.split",
      "args": {
        "direction": "right",
        "mod": "prs"
      }
    },
    "ctrl-shift-m": "mod.open:devices"
  },
  "layout:all-agents": {
    "ctrl-a": "all-agents.all",
    "ctrl-d": "all-agents.done",
    "ctrl-w": "all-agents.working",
    "ctrl-i": "all-agents.idle",
    "ctrl-b": "all-agents.blocked"
  },
  "mod:editor": {
    "ctrl-s": "editor.save",
    "ctrl-shift-v": "editor.preview"
  }
}
